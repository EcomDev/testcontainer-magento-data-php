{
    "name": "ecomdev/testcontainers-magento-data",
    "description": "TestContainers for Magento data in integration/functional tests",
    "type": "library",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "testcontainers/testcontainers": "^1.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpmd/phpmd": "^3.0",
        "ext-pdo": "*",
        "brianium/paratest": "^7.7",
        "guzzlehttp/guzzle": "^8.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcomDev\\TestContainers\\MagentoData\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EcomDev\\TestContainers\\MagentoData\\": "tests"
        }
    },
    "scripts": {
        "test": "paratest ./tests/ ",
        "unit": "paratest ./tests/ --exclude-group=slow",
        "static:phpstan": "phpstan analyse --level=8 src",
        "static:phpmd": "phpmd analyze ./src --format text --ruleset ./phpmd.ruleset.xml",
        "static": [
            "@static:phpstan",
            "@static:phpmd",
            "@format:check"
        ],
        "format:check": "phpcs --standard=PSR12 ./src/ ./tests/",
        "format:write": "phpcbf --standard=PSR12 ./src/ ./tests/"
    },
    "authors": [
        {
            "name": "Ivan Chepurnyi",
            "email": "ivan.chepurnyi@ecomdev.org"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
